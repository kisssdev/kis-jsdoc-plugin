{
  "name": "kis-jsdoc-plugin",
  "version": "2.2.4",
  "description": "A jsdoc plugin associated with a custom template that generates markdown documentation in a 'Keep It Simple' way.",
  "main": "index.js",
  "scripts": {
    "lint": "eslint ./index.js ./templates/**/*.js",
    "test": "npm run lint && jasmine",
    "doc": "jsdoc -c ./.jsdoc.json",
    "bump": "npm version --no-git-tag-version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kisssdev/kis-jsdoc-plugin.git"
  },
  "keywords": [
    "jsdoc",
    "plugin",
    "markdown"
  ],
  "author": "KisssDev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kisssdev/kis-jsdoc-plugin/issues"
  },
  "homepage": "https://github.com/kisssdev/kis-jsdoc-plugin#readme",
  "dependencies": {
    "handlebars": "^4.7.10",
    "line-column": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-array-func": "^5.1.1",
    "eslint-plugin-jasmine": "^4.2.2",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^17.13.0",
    "jasmine": "^7.0.0",
    "jasmine-spec-reporter": "^7.0.0",
    "jsdoc": "^4.0.5",
    "jsdoc-escape-at": "^1.0.1",
    "mock-require": "^3.0.3",
    "prettier": "^3.9.10"
  },
  "files": [
    "index.js",
    "templates",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "glob": "^14.0.3"
  }
}
